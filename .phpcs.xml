<?xml version="1.0"?>
<ruleset name="CustomRuleset">
    <description>Custom ruleset for my project.</description>
    <rule ref="PSR12"/>
    <!-- Several test assertions hold full literal SQL strings on one line
         for readability/diffability; treat the 120-char guideline as
         advisory rather than build-failing. -->
    <arg name="warning-severity" value="0"/>
</ruleset>
