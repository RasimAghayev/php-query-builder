# This library has zero runtime configuration — QueryBuilder reads no
# environment variables (grep confirmed: no getenv/$_ENV/putenv/$_SERVER
# usage anywhere in src/). The one variable below is consumed only by
# docker-compose.yml, to let the host port be moved if 20030 is busy;
# it is never read by application code.
#
# Copy to .env and adjust if needed: cp .env.example .env
# (docker-compose reads .env from the project root automatically)

# Host port the "app" service's demo HTTP server is published on.
# Reserved block for this repo: 20030-20039 (projects/info/state/ports.md).
APP_HTTP_PORT=20030
